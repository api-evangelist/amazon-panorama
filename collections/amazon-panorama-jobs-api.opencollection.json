        {
          "info": {
            "name": "Amazon Panorama Describe Device Job",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "http://panorama.{region}.amazonaws.com/jobs/:JobId",
            "headers": [
              {
                "name": "X-Amz-Content-Sha256",
